# ─────────────────────────────────────────────────────────────
# Environment variables for WC2026 Football Alerts (n8n workflow)
# Copy this file to `.env` and fill in your real values.
# NEVER commit your real `.env` file.
# ─────────────────────────────────────────────────────────────

# --- API-Football (https://www.api-football.com/) ---
# Sign up at api-football.com (or via RapidAPI) and paste your key here.
# Used by the "Fetch ..." HTTP Request nodes and the results Code node.
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY

# --- Twilio (https://www.twilio.com/whatsapp) ---
# From the Twilio Console. The workflow sends WhatsApp messages via Twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio WhatsApp sender. +14155238886 is the Twilio Sandbox number.
TWILIO_WHATSAPP_FROM=+14155238886

# --- Recipients ---
# Comma-separated list of WhatsApp numbers (E.164 format) to notify.
# In the published workflow these live inside the Code nodes; replace the
# placeholder numbers there, or refactor to read this variable.
NOTIFY_RECIPIENTS=+10000000001,+10000000002,+10000000003

# --- n8n runtime (production / Railway) ---
# Public URL of your n8n instance (used for webhooks & the editor).
N8N_HOST=your-instance.up.railway.app
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-instance.up.railway.app/
GENERIC_TIMEZONE=America/Costa_Rica

# Persistence (Railway Postgres recommended for production)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=your-db-host
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=your_db_password

# Encryption key for stored credentials (generate a random 32+ char string).
# Keep this stable across deploys or saved credentials become unreadable.
N8N_ENCRYPTION_KEY=generate_a_long_random_string
